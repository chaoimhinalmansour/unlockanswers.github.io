    },
    {
      "id": "B03-RW-U03-W-f11a107f3",
      "term": "connect",
      "pos": "(v)",
      "ipa": "/kənˈɛkt/",
      "definition": "to join two things or places together",
      "example": "The new bridge will connect the two towns.",
      "exampleMark": "connect",
      "picture": "practice/data/classroom-vocabulary/media/2a331bc29258b6e6e43c8741.webp",
