    },
    {
      "id": "B03-RW-U03-W-38e4e4b0a",
      "term": "attempt",
      "pos": "(v)",
      "ipa": "/ɐtˈɛmpt/",
      "definition": "if you make an attempt to do something, you try to do it",
      "example": "She made an attempt to fix the bike before asking for help.",
