    },
    {
      "id": "B03-RW-U03-W-2824b7c1a",
      "term": "commuter",
      "pos": "(n)",
      "ipa": "/kəmjˈuːtɐ/",
      "definition": "someone who travels between home and work, or university, regularly",
      "example": "The commuter takes a ferry to work.",
      "exampleMark": "commuter",
      "picture": "practice/data/classroom-vocabulary/media/4bbef0172cbc6b260c9badc8.webp",
